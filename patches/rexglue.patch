+void VulkanCommandProcessor::CloseActiveOcclusionQuery() {
+  if (!active_occlusion_query_.valid || occlusion_query_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  uint32_t host_index = active_occlusion_query_.host_index;
+  active_occlusion_query_ = {};
