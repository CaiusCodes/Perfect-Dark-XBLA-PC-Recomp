+// Server browser results (session_mutex) and what this PC's hosted match
+// reports.
+std::vector<Candidate> browse_results;
+std::atomic<bool> browsing{false};
+uint32_t session_slots = 0;
+bool session_started = false;
+std::mutex details_mutex;
+std::string match_arena;
+std::string match_mode;
+std::mutex traffic_mutex;
+std::map<uint32_t, std::chrono::steady_clock::time_point> peer_traffic;
+
+// Other players this PC has had game traffic from in the last five seconds.
+int ActivePeers() {
+  const auto cutoff = std::chrono::steady_clock::now() - std::chrono::seconds(5);
+  const Identity& self = Local();
+  std::lock_guard<std::mutex> lock(traffic_mutex);
+  int count = 0;
+  for (auto it = peer_traffic.begin(); it != peer_traffic.end();) {
+    if (it->second < cutoff) {
+      it = peer_traffic.erase(it);
+      continue;
+    }
+    if (std::find(self.addresses.begin(), self.addresses.end(), it->first) ==
+        self.addresses.end()) {
+      ++count;
+    }
+    ++it;
+  }
+  return count;
+}
