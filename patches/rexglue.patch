+  if (!occlusion_query_readback_mapping_) {
+    return false;
+  }
+  uint64_t samples = NormalizeOcclusionSamples(occlusion_query_readback_mapping_[host_index]);
+  WriteGuestOcclusionResult(sample_counts, samples);
