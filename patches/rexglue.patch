+bool BrowseJoin(size_t index, uint32_t user_index) {
+  Candidate match;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (index >= browse_results.size()) {
+      return false;
+    }
+    match = browse_results[index];
+    // The lobby the title opens for the join is a host session; it stays
+    // quiet until the join has happened.
+    seeking = true;
+    AcceptLocked(match, user_index);
+  }
+  AnnounceJoin(match);
+  REX_KERNEL_STATE()->BroadcastNotification(kNotificationInviteAccepted, user_index);
+  return true;
+}
