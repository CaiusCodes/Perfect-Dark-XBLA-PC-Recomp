+    // Commit the mirror for the range.
+    const uint32_t commit_first = (page_first << page_size_log2_) >> kUploadMirrorCommitLog2;
+    const uint32_t commit_last = ((page_end << page_size_log2_) - 1) >> kUploadMirrorCommitLog2;
+    for (uint32_t i = commit_first; i <= commit_last; ++i) {
+      uint64_t& committed = upload_mirror_committed_[i >> 6];
+      if (committed & (uint64_t(1) << (i & 63))) {
+        continue;
+      }
+      if (!memory::AllocFixed(upload_mirror_ + (size_t(i) << kUploadMirrorCommitLog2),
