+// What kind of network an adapter is on; empty to leave it out.
+std::string AdapterLabel(const IP_ADAPTER_ADDRESSES* adapter) {
+  const std::string name =
+      AdapterText(adapter->FriendlyName) + " " + AdapterText(adapter->Description);
+  auto has = [&](const char* word) { return name.find(word) != std::string::npos; };
+  if (has("hamachi")) return "Hamachi";
+  if (has("zerotier")) return "ZeroTier";
+  if (has("radmin")) return "Radmin";
+  if (has("tailscale")) return "Tailscale";
+  if (has("virtualbox") || has("vmware") || has("hyper-v") || has("vethernet") ||
+      has("wsl") || has("loopback") || has("npcap") || has("bluetooth")) {
+    return "";
+  }
+  if (has("wireguard") || has("openvpn") || has("tap-windows") || has("vpn")) return "VPN";
+  if (adapter->IfType == IF_TYPE_IEEE80211) return "Wi-Fi";
+  return "LAN";
+}
