+// PCI vendor id of the first hardware GPU, 0 if unknown. DXGI is loaded at run
+// time so nothing links against it here.
+uint32_t PrimaryGpuVendorId() {
+#if REX_PLATFORM_WIN32
+  // Test aid: REX_TEST_GPU_VENDOR=1002 (hex) makes auto act as on that vendor's GPU.
+  if (const char* forced = std::getenv("REX_TEST_GPU_VENDOR")) {
+    return uint32_t(std::strtoul(forced, nullptr, 16));
+  }
+  HMODULE dxgi = ::LoadLibraryW(L"dxgi.dll");
+  if (!dxgi) return 0u;
+  using CreateFactory1Fn = HRESULT(WINAPI*)(REFIID, void**);
+  auto create_factory1 =
+      reinterpret_cast<CreateFactory1Fn>(::GetProcAddress(dxgi, "CreateDXGIFactory1"));
+  uint32_t vendor = 0u;
+  IDXGIFactory1* factory = nullptr;
+  if (create_factory1 && SUCCEEDED(create_factory1(IID_PPV_ARGS(&factory))) && factory) {
+    IDXGIAdapter1* adapter = nullptr;
+    for (UINT i = 0; factory->EnumAdapters1(i, &adapter) == S_OK; ++i) {
+      DXGI_ADAPTER_DESC1 desc;
+      const bool hardware =
+          SUCCEEDED(adapter->GetDesc1(&desc)) && !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE);
+      adapter->Release();
+      adapter = nullptr;
+      if (hardware) {
+        vendor = desc.VendorId;  // the first hardware adapter is the one used
+        break;
+      }
+    }
+    factory->Release();
+  }
+  ::FreeLibrary(dxgi);
+  return vendor;
+#else
+  return 0u;
+#endif
+}
+
+std::string ResolveGpuBackend() {
+  const std::string choice = REXCVAR_GET(gpu);
+  if (choice == "d3d12" || choice == "vulkan") {
+    REXLOG_INFO("gpu = {}", choice);
+    return choice;
+  }
+  const uint32_t vendor = PrimaryGpuVendorId();
+#if REX_HAS_VULKAN
+  const std::string backend = vendor == 0x10DEu ? "d3d12" : "vulkan";
+#else
+  // This SDK build has no Vulkan backend (REXGLUE_USE_VULKAN off), so every
+  // GPU gets Direct3D 12.
+  const std::string backend = "d3d12";
+#endif
+  REXLOG_INFO("gpu = auto: GPU vendor {:04X} -> {}", vendor, backend);
+  return backend;
+}
