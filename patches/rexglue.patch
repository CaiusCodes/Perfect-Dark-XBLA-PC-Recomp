+// One ask of the host for its value: true and `out` filled on an answer.
+bool AskHostValue(uint32_t host_ina, RelayInbox* inbox, socket_t s, HostValue* out) {
+  uint8_t query[8];
+  PutBE32(query, kValueQueryMagic);
+  PutBE32(query + 4, kProtocolVersion);
+  const auto sent_at = std::chrono::steady_clock::now();
+  uint8_t answer[32];
+  int received = -1;
+  if (inbox) {
+    RelaySend(inbox->port(), host_ina, kDiscoveryPort, query, sizeof(query));
+    uint32_t from = 0;
+    received = inbox->Receive(400, answer, sizeof(answer), &from);
+  } else {
+    sockaddr_in target = {};
+    target.sin_family = AF_INET;
+    target.sin_port = htons(kDiscoveryPort);
+    target.sin_addr.s_addr = host_ina;
+    sendto(s, reinterpret_cast<const char*>(query), sizeof(query), 0,
+           reinterpret_cast<const sockaddr*>(&target), sizeof(target));
+    fd_set readable;
+    FD_ZERO(&readable);
+    FD_SET(s, &readable);
+    timeval timeout = {0, 400 * 1000};
+    if (select(int(s + 1), &readable, nullptr, nullptr, &timeout) > 0) {
+      received = recvfrom(s, reinterpret_cast<char*>(answer), sizeof(answer), 0, nullptr, nullptr);
+    }
+  }
+  if (received < 20 || GetBE32(answer) != kValueAnswerMagic ||
+      GetBE32(answer + 4) != kProtocolVersion) {
+    return false;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  out->seq = GetBE32(answer + 8);
+  out->value = GetBE32(answer + 12);
+  const uint32_t age_ms = GetBE32(answer + 16);
+  // The value was set `age` before the host answered; the answer took about
+  // half the round trip to get here.
+  const auto half_trip = (now - sent_at) / 2;
+  out->set_at = out->seq == 0 ? std::chrono::steady_clock::time_point{}
+                              : now - half_trip - std::chrono::milliseconds(age_ms);
+  return true;
+}
+
+// While this PC is in a match it joined, asks the host for its value twice a
+// second (a 20-byte answer) and keeps the latest.
+void StartValuePoll() {
+  bool expected = false;
+  if (!value_poll_running.compare_exchange_strong(expected, true)) {
+    return;
+  }
+  std::thread([] {
+    EnsureWinsock();
+    std::unique_ptr<RelayInbox> inbox;
+    socket_t s = kNoSocket;
+    if (RelayActive()) {
+      inbox = std::make_unique<RelayInbox>();
+    } else {
+      s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+      if (s != kNoSocket) {
+        sockaddr_in local = {};
+        local.sin_family = AF_INET;
+        local.sin_addr.s_addr = ConfiguredAddress();  // 0 = any address
+        bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+      }
+    }
+    uint32_t last_seq = 0;
+    for (;;) {
+      uint32_t host_ina = 0;
+      {
+        std::lock_guard<std::mutex> lock(session_mutex);
+        if (!joined) {
+          break;
+        }
+        host_ina = joined_host_ina;
+      }
+      HostValue heard;
+      if (host_ina && (inbox || s != kNoSocket) && AskHostValue(host_ina, inbox.get(), s, &heard)) {
+        heard.valid = true;
+        if (heard.seq != last_seq) {
+          last_seq = heard.seq;
+          REXKRNL_INFO("[netplay] host value #{} = {}", heard.seq, heard.value);
+        }
+        std::lock_guard<std::mutex> lock(host_value_mutex);
+        heard_value = heard;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    }
+    if (s != kNoSocket) {
+      CloseSocket(s);
+    }
+    {
+      std::lock_guard<std::mutex> lock(host_value_mutex);
+      heard_value = HostValue{};
+    }
+    value_poll_running = false;
+  }).detach();
+}
+
+}  // namespace
+
+bool LatestHostValue(HostValue* out) {
+  if (!IsJoinedSession()) {
+    return false;
+  }
+  StartValuePoll();
+  std::lock_guard<std::mutex> lock(host_value_mutex);
+  if (!heard_value.valid || heard_value.seq == 0) {
+    return false;
+  }
+  *out = heard_value;
+  return true;
+}
