+// The socket rules changed since this socket was bound (online play was
+// switched on or off while the game was running): bind it again, on this
+// thread, before the call that noticed goes ahead.
+void XSocket::ApplyNetplayGeneration() {
+  const uint32_t generation = NetplayGeneration();
+  if (bound_generation_ == generation) {
+    return;
+  }
+  bound_generation_ = generation;
+  if (!has_bind_request_) {
+    return;
+  }
+  RebindForNetplay();
