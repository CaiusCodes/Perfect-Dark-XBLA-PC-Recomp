diff --git a/include/rex/kernel/xam/local_leaderboards.h b/include/rex/kernel/xam/local_leaderboards.h
new file mode 100644
index 0000000..87bf22e
--- /dev/null
+++ b/include/rex/kernel/xam/local_leaderboards.h
@@ -0,0 +1,96 @@
+/**
+ * @file        kernel/xam/local_leaderboards.h
+ * @brief       Offline Xbox LIVE leaderboards, filled from the title's own
+ *              stats writes and read back through the regular stats APIs.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rex::kernel::xam::leaderboards {
+
+// Titles report scores with XSessionWriteStats and read leaderboards with
+// XUserCreateStatsEnumerator* / XUserReadStats. With no Xbox LIVE service
+// behind them, every stats write is kept as a local leaderboard entry (per
+// view, best first) in <user data>/leaderboards/<title id>.txt, and reads are
+// answered from that list. Columns are mapped to the written properties with
+// the title's own leaderboard definitions (the "XVC2" section of its SPA).
+
+// XUSER_DATA scalar: the type byte and the raw value (32-bit types use the
+// low half).
+struct UserData {
+  uint8_t type = 0;
+  uint64_t bits = 0;
+};
+
+// XUSER_PROPERTY, as written by XSessionWriteStats.
+struct Property {
+  uint32_t id = 0;
+  UserData value;
+};
+
+// XUSER_STATS_SPEC: a view and the column attribute ids to return.
+struct StatsSpec {
+  uint32_t view_id = 0;
+  std::vector<uint16_t> columns;
+};
+
+// XamUserCreateStatsEnumerator's enumeration types.
+enum class EnumerateBy : uint32_t { kXuid = 0, kRank = 1, kRating = 2 };
+
+// A host-side XUSER_STATS_READ_RESULTS, laid out into guest memory by Write()
+// once the destination address is known.
+class ResultSet {
+ public:
+  struct Row {
+    uint64_t xuid = 0;
+    uint32_t rank = 0;
+    int64_t rating = 0;
+    std::string gamertag;
+    std::vector<std::pair<uint16_t, UserData>> columns;
+  };
+  struct View {
+    uint32_t view_id = 0;
+    uint32_t total_rows = 0;
+    std::vector<Row> rows;
+  };
+
+  std::vector<View>& views() { return views_; }
+
+  // Bytes Write() needs.
+  uint32_t size() const;
+
+  // Writes the results to `host`, which the guest sees at `guest_address`.
+  void Write(uint8_t* host, uint32_t guest_address) const;
+
+ private:
+  std::vector<View> views_;
+};
+
+// Parses `count` guest XUSER_STATS_SPEC structures.
+std::vector<StatsSpec> ReadSpecs(const uint8_t* specs, uint32_t count);
+
+// Records one view of an XSessionWriteStats call as a leaderboard entry.
+void RecordStats(uint32_t view_id, uint64_t xuid, const std::vector<Property>& properties);
+
+// XUserCreateStatsEnumeratorBy{Xuid,Rank,Rating}.
+ResultSet QueryEnumerator(const std::vector<StatsSpec>& specs, EnumerateBy by, uint64_t pivot,
+                          uint32_t num_rows);
+
+// XUserReadStats: one row per requested player (rank 0 when unranked).
+ResultSet QueryPlayers(const std::vector<StatsSpec>& specs, const std::vector<uint64_t>& xuids);
+
+// There is no friends list offline. Enumerations a title sets up for one are
+// remembered here so XamEnumerate can report them empty rather than invalid,
+// which lets a Friends leaderboard fall through to the local player's row.
+void RegisterEmptyEnumeration(uint32_t handle);
+bool IsEmptyEnumeration(uint32_t handle);
+
+}  // namespace rex::kernel::xam::leaderboards
diff --git a/include/rex/kernel/xam/netplay.h b/include/rex/kernel/xam/netplay.h
new file mode 100644
index 0000000..4f8916f
--- /dev/null
+++ b/include/rex/kernel/xam/netplay.h
@@ -0,0 +1,229 @@
+/**
+ * ReXGlue runtime - Xbox LIVE Private Match over the local network.
+ *
+ * With net_private_match on, a title's LIVE Private Match runs between PCs on
+ * the same network (or a virtual LAN such as ZeroTier or Radmin VPN) with no
+ * Xbox LIVE service: the host's session carries this PC's address, games on
+ * the network answer searches for hosted matches, and a match that answers is
+ * handed to the title as an accepted game invite.
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam::netplay {
+
+// Guest structure sizes (big-endian layouts).
+constexpr size_t kXnAddrSize = 36;       // XNADDR
+constexpr size_t kSessionInfoSize = 60;  // XSESSION_INFO: XNKID, host XNADDR, XNKEY
+constexpr size_t kInviteInfoSize = 84;   // XINVITE_INFO
+
+// XN_LIVE_INVITE_ACCEPTED; its parameter is the accepting user's index.
+constexpr uint32_t kNotificationInviteAccepted = 0x02000002;
+
+// net_private_match is on.
+bool Enabled();
+// Switch online play on or off while the game is running - what the title's
+// own menu does when the player picks an online match, so nothing touches the
+// network (and Windows never asks about the firewall) until they do. Sockets
+// already bound are bound again under the new rules the next time the game
+// uses them.
+void SetEnabled(bool on);
+
+// Which way a match is reached. LAN and Direct Connect use this PC's own
+// network interfaces (a home network, or a virtual LAN the players set up
+// themselves); ONLINE goes through the relay server (net_relay_server). The
+// relay is only used while online mode is on, so LAN and Direct Connect keep
+// working whatever relay address is configured.
+void SetOnlineMode(bool on);
+bool OnlineMode();
+
+// Direct Connect: the host to ask, as an IPv4 address or a hostname (a port,
+// if typed, is ignored - the game's ports are fixed). The next join search
+// asks only that host. Cleared by a LAN browse.
+void SetDirectTarget(const std::string& address);
+// The title should see a signed-in, connected LIVE profile with multiplayer
+// privileges (whenever Private Match networking is on).
+bool LiveOnline();
+// net_address (network byte order) while Private Match is on and it is set;
+// 0 otherwise. Sockets of a copy with its own address bind to it.
+uint32_t ConfiguredAddress();
+
+// The XUID and gamertag the title sees. With Private Match on, each PC gets
+// its own stable XUID (players in one match must differ) and the Windows user
+// name or net_player_name; saves keep using the profile's own XUID.
+uint64_t PlayerXuid(uint64_t profile_xuid);
+std::string PlayerName(const std::string& profile_name);
+// The name this PC would use online whether or not online play is on, for a
+// settings screen to show: net_player_name, else the Windows user name.
+std::string ConfiguredPlayerName(const std::string& profile_name);
+
+void RandomBytes(uint8_t* out, size_t size);
+
+// Fills a guest XNADDR describing this PC.
+void FillLocalXnAddr(uint8_t* xnaddr);
+// Machine ID of the PC a guest XNADDR describes.
+uint64_t MachineId(const uint8_t* xnaddr);
+// IPv4 address (network byte order) that reaches the PC a guest XNADDR
+// describes; remembered so InAddrToXnAddr can map it back.
+uint32_t XnAddrToInAddr(const uint8_t* xnaddr);
+// Fills a guest XNADDR for a peer address (network byte order).
+void InAddrToXnAddr(uint32_t ina, uint8_t* xnaddr);
+
+// XNetQosListen: data this PC offers to QoS lookups (XNET_QOS_LISTEN_* flags:
+// 0x04 sets the data, 0x10 releases it).
+void SetQosListen(const uint8_t* data, uint32_t size, uint32_t flags);
+
+struct QosResult {
+  bool contacted = false;
+  uint32_t rtt_ms = 0;
+  std::vector<uint8_t> data;  // the target's XNetQosListen data
+};
+// XNetQosLookup of one peer: asks the PC a guest XNADDR describes for its QoS
+// data. Blocks for well under a second.
+QosResult QosProbe(const uint8_t* xnaddr);
+
+// XSessionCreate: a host session gets a new ID, this PC's address and a key,
+// and is announced to Private Match searches on the network.
+// `slots` is the session's public + private slots (the most players).
+void OnSessionCreated(uint32_t flags, uint32_t slots, uint8_t* session_info, uint8_t* nonce);
+// XSessionStart / XSessionEnd: the hosted match is being played.
+void OnSessionStarted(bool started);
+void OnSessionDeleted();
+// The current session's XNKID (zeros when there is none).
+void CurrentSessionId(uint8_t* xnkid);
+
+// Looks for hosted Private Matches in the background (net_join_address, which
+// may list several hosts separated by commas, or the local network). One
+// answer is handed to the title as an accepted invite for user_index; with
+// several, the player chooses (PendingMatchChoice / ChooseMatch). While the
+// search and choice last, this PC's own lobby does not answer other searches.
+void BeginJoinSearch(uint32_t user_index);
+
+// One hosted match a search heard.
+struct FoundMatch {
+  std::string host_name;
+  std::string address;  // dotted IPv4
+};
+// True while the player has to choose between several hosted matches; fills
+// `matches` (when given) with them in the order they answered.
+bool PendingMatchChoice(std::vector<FoundMatch>* matches);
+// Joins pending match `index`; any other index cancels the choice and leaves
+// the player in their own lobby.
+void ChooseMatch(size_t index);
+
+// XamShowFriendsUI (the lobby's Invite Friends button): in a lobby this PC
+// hosts or joined, tells the player how friends join; otherwise searches.
+void OnInviteFriends(uint32_t user_index);
+// XInviteGetAcceptedInfo: fills a guest XINVITE_INFO.
+bool GetAcceptedInvite(uint32_t user_index, uint8_t* invite_info);
+
+// A short message for the game window about the latest search ("Looking for
+// an online match...", "No online match found..."). Returns true and fills
+// `text` once for each new message.
+bool TakeNotice(std::string* text);
+// Puts a message of the title's own into the same banner.
+void ShowNotice(const std::string& text);
+
+// This PC's addresses that other players could reach, each named by the kind
+// of network it is on ("LAN", "Wi-Fi", "Hamachi", "ZeroTier", "Radmin",
+// "Tailscale", "VPN"), home network first. Host-only virtual adapters
+// (VirtualBox, VMware, Hyper-V, WSL) are left out: nobody else can reach them.
+// Cheap to call every frame (refreshed at most every two seconds).
+struct LocalAddress {
+  std::string label;
+  std::string address;  // dotted IPv4
+};
+std::vector<LocalAddress> LocalAddresses();
+
+// True while this PC hosts a match (LAN or Direct Connect).
+bool IsHostingSession();
+
+// True while this PC is in a match it joined, rather than one it hosts.
+bool IsJoinedSession();
+
+// A small value the host shares with the players in its match, for a title
+// whose PCs must agree on something the game itself does not send (Perfect
+// Dark: the multiplayer music track). The host sets it; each joined PC asks
+// the host for it twice a second (UDP 3076, or through the online server).
+void SetHostValue(uint32_t value);
+struct HostValue {
+  bool valid = false;
+  uint32_t seq = 0;    // counts the host's SetHostValue calls
+  uint32_t value = 0;
+  std::chrono::steady_clock::time_point set_at;  // when the host set it, on this PC's clock
+};
+// On a joined PC: the host's latest value, false until one has been heard
+// (the first call starts the polling). Never waits for the network.
+bool LatestHostValue(HostValue* out);
+
+// Internet play through a relay server (net_relay_server; the server is
+// perfect-dark-recomp/tools/relay/pd_relay.py). The server is a virtual LAN
+// switch: each copy gets a virtual address 10.77.x.y in its room (net_room),
+// and every packet for such an address, or a broadcast, goes through it. The
+// game only ever sends to the server, so no router set-up is needed.
+bool RelayActive();
+// A packet for `ina` (network byte order) goes through the relay.
+bool RelayRoutes(uint32_t ina);
+void RelaySend(uint16_t src_port, uint32_t dst_ina, uint16_t dst_port, const uint8_t* data,
+               size_t size);
+// Delivers relay packets for a local port. Called on the relay thread, with
+// the listener table locked, so a receiver must be quick and must not call
+// RelayListen/RelayUnlisten.
+using RelayReceiver =
+    std::function<void(uint32_t src_ina, uint16_t src_port, const uint8_t* data, size_t size)>;
+void RelayListen(uint16_t port, RelayReceiver receiver);
+void RelayUnlisten(uint16_t port);
+// A free local port number for a socket the title never bound.
+uint16_t RelayEphemeralPort();
+
+// Server browser (the title's "Find Online Match"): every hosted match a
+// search heard, with what its host reports about it.
+struct BrowserMatch {
+  std::string name;     // host's player name
+  std::string address;  // dotted IPv4 (a 10.77.x.y address on the online server)
+  std::string arena;
+  std::string mode;
+  int players = 0;      // 0 = not reported
+  int max_players = 0;  // 0 = not reported
+  bool in_progress = false;
+  int ping_ms = 0;
+};
+// Searches in the background; the results replace the list when it ends.
+void BrowseRefresh();
+// Direct Connect: asks only `address` (IPv4 or hostname). The answer, if any,
+// becomes the one browser result, joined with BrowseJoin like any other.
+void BrowseDirect(const std::string& address);
+bool BrowseSearching();
+std::vector<BrowserMatch> BrowseResults();
+// Joins result `index` as an accepted invite. False if it is gone.
+bool BrowseJoin(size_t index, uint32_t user_index);
+// Host side: the arena and mode this PC's match shows in other browsers.
+void SetMatchDetails(const std::string& arena, const std::string& mode);
+// A game packet arrived from `ina` (network byte order); the host counts the
+// players it has heard from in the last few seconds.
+void NotePeerTraffic(uint32_t ina);
+
+// What the title's own Online settings page shows. Cheap to call every frame:
+// it reads the current state and never waits for the network, so `connected`
+// is false until something has actually registered with the server.
+struct OnlineStatus {
+  bool enabled = false;           // net_private_match
+  bool server_configured = false; // net_relay_server is set
+  bool connected = false;         // the server has answered
+  std::string server;             // "host" or "host:port", as configured
+  std::string room;               // net_room, or "public"
+  std::string address;            // the address others reach this PC by, if known
+};
+OnlineStatus Status();
+// Registers with the online server if that has not happened yet. Blocks for up
+// to a few seconds, so call it from a thread of your own.
+void StartOnline();
+
+}  // namespace rex::kernel::xam::netplay
diff --git a/include/rex/kernel/xam/ui_hooks.h b/include/rex/kernel/xam/ui_hooks.h
