+    ID3D12Device* device = provider.GetDevice();
+    D3D12_QUERY_HEAP_DESC heap_desc = {};
+    heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heap_desc.Count = kQueueFrames * kGpuTimeStampsPerFrame;
+    D3D12_RESOURCE_DESC buffer_desc;
