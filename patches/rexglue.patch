+        static uint64_t refreshes = 0, shown = 0, repeats = 0, drops = 0, events = 0;
+        static LARGE_INTEGER window_start{};
+        static std::string event_times;
+        static int64_t present_qpc[64] = {};
+        static LARGE_INTEGER last_sync_qpc{};
+        static uint64_t latency_n = 0, late = 0, gaps = 0;
+        static double latency_sum = 0.0, latency_max = 0.0, gap_max = 0.0;
+        static double latency_usual = 0.0;  // slow running average, kept across windows
+        static std::string late_times;
+        {
+          UINT last_id = 0;
+          if (SUCCEEDED(paint_context_.swap_chain->GetLastPresentCount(&last_id))) {
+            present_qpc[last_id & 63] = now.QuadPart;
+          }
+        }
+        DXGI_FRAME_STATISTICS fs;
+        if (SUCCEEDED(paint_context_.swap_chain->GetFrameStatistics(&fs)) && fs.PresentCount) {
+          if (!window_start.QuadPart) window_start = now;
+          const double to_ms = 1000.0 / double(freq.QuadPart);
+          if (fs.PresentCount != last_present_count && fs.SyncQPCTime.QuadPart) {
+            const int64_t called = present_qpc[fs.PresentCount & 63];
+            if (called && fs.SyncQPCTime.QuadPart >= called) {
+              const double latency = double(fs.SyncQPCTime.QuadPart - called) * to_ms;
+              if (latency < 500.0) {
+                const bool is_late = latency_usual > 0.0 && latency > latency_usual + 6.0;
+                latency_usual = latency_usual > 0.0
+                                    ? latency_usual + (latency - latency_usual) * 0.02
+                                    : latency;
+                ++latency_n;
+                latency_sum += latency;
+                latency_max = std::max(latency_max, latency);
+                if (is_late && ++late <= 6) {
+                  late_times += fmt::format(
+                      " {:.2f}s ({:.1f} ms)",
+                      double(now.QuadPart - window_start.QuadPart) / double(freq.QuadPart),
+                      latency);
+                }
+              }
+            }
+            if (last_sync_qpc.QuadPart && fs.PresentCount == last_present_count + 1) {
+              const double gap = double(fs.SyncQPCTime.QuadPart - last_sync_qpc.QuadPart) * to_ms;
+              gap_max = std::max(gap_max, gap);
+              if (gap > 25.0) ++gaps;
+            }
+            last_sync_qpc = fs.SyncQPCTime;
+          }
+          if (last_present_count && fs.PresentCount != last_present_count) {
+            const int64_t dp = int64_t(fs.PresentCount) - int64_t(last_present_count);
+            const int64_t dr = int64_t(fs.PresentRefreshCount) - int64_t(last_refresh_count);
+            if (dp > 0 && dr >= 0 && dp < 1000 && dr < 1000) {
+              shown += uint64_t(dp);
+              refreshes += uint64_t(dr);
+              if (dr != dp) {
+                if (dr > dp) {
+                  repeats += uint64_t(dr - dp);
+                } else {
+                  drops += uint64_t(dp - dr);
+                }
+                if (++events <= 6) {
+                  event_times += fmt::format(
+                      " {}{:.2f}s", dr > dp ? "+" : "-",
+                      double(now.QuadPart - window_start.QuadPart) / double(freq.QuadPart));
+                }
+              }
+            }
+          }
+          if (fs.PresentCount != last_present_count) {
+            last_present_count = fs.PresentCount;
+            last_refresh_count = fs.PresentRefreshCount;
+          }
+          if (double(now.QuadPart - window_start.QuadPart) >= 10.0 * double(freq.QuadPart)) {
+            REXLOG_INFO("[timing] display: {} frames shown over {} refreshes, {} repeated, {} "
+                        "dropped{}{}",
+                        shown, refreshes, repeats, drops, events ? "; at" : "",
+                        events > 6 ? event_times + " ..." : event_times);
+            if (latency_n) {
+              REXLOG_INFO("[timing] display: present to screen {:.1f} ms mean, {:.1f} max; {} "
+                          "late frames (over 6 ms later than usual){}{}; longest gap between "
+                          "frames on screen {:.1f} ms ({} over 25 ms)",
+                          latency_sum / double(latency_n), latency_max, late, late ? " at" : "",
+                          late > 6 ? late_times + " ..." : late_times, gap_max, gaps);
+            }
+            window_start = now;
+            refreshes = shown = repeats = drops = events = 0;
+            event_times.clear();
+            latency_n = late = gaps = 0;
+            latency_sum = latency_max = gap_max = 0.0;
+            late_times.clear();
+          }
+        }
+      }
+      if (prev.QuadPart) {
+        const double ms = double(now.QuadPart - prev.QuadPart) * 1000.0 / double(freq.QuadPart);
+        ++count;
+        sum += ms;
+        sq += ms * ms;
+        mx = std::max(mx, ms);
+      } else {
+        start = now;
+      }
+      prev = now;
+      if (double(now.QuadPart - start.QuadPart) >= 10.0 * double(freq.QuadPart) && count) {
+        const double mean = sum / double(count);
+        REXLOG_INFO("[timing] present: {} presents ({:.1f}/s), interval mean {:.3f} ms sd {:.3f} "
+                    "max {:.3f}, vsync {}",
+                    count,
+                    double(count) * double(freq.QuadPart) / double(now.QuadPart - start.QuadPart),
+                    mean, std::sqrt(std::max(0.0, sq / double(count) - mean * mean)), mx, vsync);
+        start = now;
+        count = 0;
+        sum = sq = mx = 0.0;
+      }
+    } else {
+      prev.QuadPart = 0;
+    }
+  }
