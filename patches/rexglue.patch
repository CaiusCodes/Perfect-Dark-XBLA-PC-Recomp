+std::string FormatIPv4(uint32_t address);
+
+// Packet timing per peer and direction (net_stats): how evenly the game's
+// packets leave and arrive, to tell uneven delivery from missing smoothing.
+struct NetFlowStats {
+  std::chrono::steady_clock::time_point last{};
+  bool have_last = false;
+  uint64_t packets = 0;
+  uint64_t bytes = 0;
+  double gap_sum_ms = 0.0;
+  double gap_max_ms = 0.0;
+  uint64_t gaps = 0;
+  uint64_t bursts = 0;     // arrived < 2 ms after the previous packet
+  uint64_t late = 0;       // gap more than twice the average so far
+  std::chrono::steady_clock::time_point window{};
+};
+std::mutex g_net_stats_mutex;
+std::map<std::string, NetFlowStats> g_net_stats;
+std::atomic<uint64_t> g_net_polls{0};
+std::atomic<uint64_t> g_net_empty_polls{0};
+
+void NoteNetFlow(bool enabled, const char* dir, uint32_t ina, uint16_t port, uint32_t size) {
+  if (!enabled) return;
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(g_net_stats_mutex);
+  const std::string key =
+      std::string(dir) + " " + FormatIPv4(ina) + ":" + std::to_string(port);
+  NetFlowStats& f = g_net_stats[key];
+  if (f.window.time_since_epoch().count() == 0) f.window = now;
+  if (f.have_last) {
+    const double gap = std::chrono::duration<double, std::milli>(now - f.last).count();
+    const double avg = f.gaps ? f.gap_sum_ms / double(f.gaps) : gap;
+    if (gap < 2.0) ++f.bursts;
+    if (f.gaps && gap > 2.0 * avg) ++f.late;
+    f.gap_sum_ms += gap;
+    ++f.gaps;
+    if (gap > f.gap_max_ms) f.gap_max_ms = gap;
+  }
+  f.last = now;
+  f.have_last = true;
+  ++f.packets;
+  f.bytes += size;
+  const double window = std::chrono::duration<double>(now - f.window).count();
+  if (window >= 2.0) {
+    REXLOG_INFO("[net_stats] {}: {:.1f} packets/s, {:.0f} bytes avg, gap avg {:.1f} ms max {:.1f} "
+                "ms, {} bunched (<2 ms), {} late (>2x avg); game polls {:.0f}/s ({:.0f}% empty)",
+                key, f.packets / window, f.packets ? double(f.bytes) / f.packets : 0.0,
+                f.gaps ? f.gap_sum_ms / f.gaps : 0.0, f.gap_max_ms, f.bursts, f.late,
+                g_net_polls.load() / window,
+                g_net_polls.load() ? 100.0 * g_net_empty_polls.load() / g_net_polls.load() : 0.0);
+    const auto last = f.last;
+    f = NetFlowStats{};
+    f.window = now;
+    f.last = last;
+    f.have_last = true;
+    g_net_polls = 0;
+    g_net_empty_polls = 0;
+  }
+}
+std::atomic<int> traced_sends{0};
+std::atomic<int> traced_recvs{0};
