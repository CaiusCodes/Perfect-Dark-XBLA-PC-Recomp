+// Takes everything the socket is holding, then hands back one packet if one is
+// due. Returns false when the game should be told there is nothing yet.
+bool XSocket::PaceDrainAndPick(void* out_packet) {
+  auto* out = reinterpret_cast<PacedDatagram*>(out_packet);
+  const auto now = std::chrono::steady_clock::now();
+
+  // Everything waiting in the socket, in one go.
+  for (;;) {
+    fd_set fds;
+    FD_ZERO(&fds);
+    FD_SET(native_handle_, &fds);
+    timeval zero{0, 0};
+    if (select(int(native_handle_) + 1, &fds, nullptr, nullptr, &zero) <= 0) break;
+    uint8_t scratch[2048];
+    sockaddr_in nfrom;
+    socklen_t nfromlen = sizeof(sockaddr_in);
+    int got = recvfrom(native_handle_, reinterpret_cast<char*>(scratch), sizeof(scratch), 0,
+                       (sockaddr*)&nfrom, &nfromlen);
+    if (got <= 0) break;
+    got = ClockSyncReceive(scratch, got);  // the game must never see the sync trailer
+    if (NetStatsOn()) {
+      NoteNetFlow(true, "recv", nfrom.sin_addr.s_addr, ntohs(nfrom.sin_port), uint32_t(got));
+    }
+    const uint64_t key = (uint64_t(nfrom.sin_addr.s_addr) << 16) | ntohs(nfrom.sin_port);
+    PeerPlayout& peer = playout_[key];
+    if (peer.have_last) {
+      const double gap = std::chrono::duration<double, std::milli>(now - peer.last_arrival).count();
+      if (gap > 1.0 && gap < 500.0) {
+        // How often they send, and how far from that they stray. Both settle
+        // within a second or two of play.
+        peer.interval_ms = peer.interval_ms * 0.9 + gap * 0.1;
+        const double off = std::fabs(gap - peer.interval_ms);
+        peer.jitter_ms = peer.jitter_ms * 0.9 + off * 0.1;
+      }
+    }
+    peer.last_arrival = now;
+    peer.have_last = true;
+    ++peer.seen;
+    PacedDatagram held;
+    held.data.assign(scratch, scratch + got);
+    held.src_ina = nfrom.sin_addr.s_addr;
+    held.src_port = ntohs(nfrom.sin_port);
+    held.arrived = now;
+    peer.queue.push_back(std::move(held));
+  }
+
+  // Whichever peer has something due. A stream we have only just met, or one
+  // whose queue has grown past a few packets, goes straight through: joining
+  // must not be delayed, and a backlog must not turn into lasting lag.
+  const double cap = double(REXCVAR_GET(net_pace_max_ms));
+  for (auto& entry : playout_) {
+    PeerPlayout& peer = entry.second;
+    if (peer.queue.empty()) continue;
+    const bool settling = peer.seen < 30;
+    const bool backed_up = peer.queue.size() > 4;
+    double hold = peer.jitter_ms * 2.5;
+    if (hold < 0.0) hold = 0.0;
+    if (hold > cap) hold = cap;
+    const auto ready = peer.queue.front().arrived + std::chrono::microseconds(int64_t(hold * 1000));
+    const bool due = now >= ready && now >= peer.next_release;
+    if (!settling && !backed_up && !due) continue;
+    *out = std::move(peer.queue.front());
+    peer.queue.pop_front();
+    // The next one no sooner than their own sending rate, which is what evens
+    // out a bunch that arrived together.
+    peer.next_release = now + std::chrono::microseconds(int64_t(peer.interval_ms * 1000.0 * 0.9));
+    return true;
+  }
+  return false;
+}
