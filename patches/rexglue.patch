+void Presenter::GuestOutputPacingThread() {
+  rex::thread::set_current_thread_name("Guest Output Pacing");
+  using Clock = std::chrono::steady_clock;
+  // Sleep on a high-resolution timer until shortly before the present moment,
+  // then yield-spin the rest. This is a host thread, not a guest one.
+  constexpr auto kWakeAhead = std::chrono::microseconds(700);
+#if REX_PLATFORM_WIN32
+  HANDLE sleep_timer = CreateWaitableTimerExW(nullptr, nullptr,
+                                              CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                              TIMER_ALL_ACCESS);
+#endif
+  auto precise_sleep = [&](Clock::duration d) {
+#if REX_PLATFORM_WIN32
+    if (sleep_timer) {
+      LARGE_INTEGER due;
+      due.QuadPart = -std::max<int64_t>(
+          1, std::chrono::duration_cast<std::chrono::nanoseconds>(d).count() / 100);
+      if (SetWaitableTimer(sleep_timer, &due, 0, nullptr, nullptr, FALSE)) {
+        WaitForSingleObject(sleep_timer, INFINITE);
+        return;
+      }
+    }
+#endif
+    std::this_thread::sleep_for(d);
+  };
+  Clock::time_point last_target{};
+  // vblank_timing_log: when frames arrive after their vblank, and pacing misses.
+  Clock::time_point window_start = Clock::now(), last_present{};
+  uint32_t presents = 0, empty_vblanks = 0, late_frames = 0;
+  double arrival_max_ms = 0.0, interval_sum = 0.0, interval_sq = 0.0, interval_max = 0.0;
+  std::vector<float> arrivals;
+  while (true) {
+    Clock::time_point vblank_time;
+    Clock::duration period;
+    {
+      std::unique_lock<std::mutex> lock(guest_output_pacing_mutex_);
+      guest_output_pacing_condition_.wait(lock, [&]() {
+        return guest_output_pacing_shutdown_ || guest_output_pacing_vblank_count_ >= 2;
+      });
+      if (guest_output_pacing_shutdown_) {
+        break;
+      }
+      vblank_time = guest_output_pacing_vblank_time_;
+      period = guest_output_pacing_vblank_period_;
+    }
+    if (period <= Clock::duration::zero()) {
+      precise_sleep(std::chrono::milliseconds(1));
+      continue;
+    }
+    Clock::duration offset = std::min<Clock::duration>(
+        std::chrono::microseconds(REXCVAR_GET(present_pacing_offset_us)), period);
+    if (offset <= Clock::duration::zero()) offset = period;
+    // The next present moment after the last one, anchored to the latest vblank.
+    Clock::time_point target = vblank_time + offset;
+    while (target <= last_target + period / 2) {
+      target += period;
+    }
+    Clock::time_point now = Clock::now();
+    if (target - now > period * 2) {
+      // The guest clock stalled or jumped; resynchronise on the next tick.
+      last_target = Clock::time_point{};
+      precise_sleep(std::chrono::milliseconds(1));
+      continue;
+    }
+    if (target - now > kWakeAhead) {
+      precise_sleep(target - now - kWakeAhead);
+    }
+    while (Clock::now() < target) {
+      std::this_thread::yield();
+    }
+    last_target = target;
+    if (!guest_output_paced_frame_pending_.exchange(false, std::memory_order_acq_rel)) {
+      ++empty_vblanks;
+      continue;
+    }
+    PresentLatestGuestOutput();
+    if (rex::diag::TimingLogOn()) {
+      const Clock::time_point presented = Clock::now();
+      const Clock::time_point arrival{
+          Clock::duration(guest_output_paced_frame_arrival_.load(std::memory_order_relaxed))};
+      // Negative arrival: the frame came in before this present's vblank, i.e.
+      // it missed the previous present moment and waited a whole tick.
+      const double arrival_ms =
+          std::chrono::duration<double, std::milli>(arrival - (target - offset)).count();
+      if (arrival_ms < 0.0) ++late_frames;
+      arrivals.push_back(float(arrival_ms));
+      arrival_max_ms = std::max(arrival_max_ms, arrival_ms);
+      if (last_present != Clock::time_point{}) {
+        const double ms =
+            std::chrono::duration<double, std::milli>(presented - last_present).count();
