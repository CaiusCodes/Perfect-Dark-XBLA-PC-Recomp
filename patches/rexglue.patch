+
+// vblank_timing_log: the game's own frame times (one VdSwap per frame), each
+// frame over 25 ms on its own line, and a sampler that records where the
+// thread that presents frames is (its guest return address) when a frame is
+// late, so a stutter report says what the game was waiting on.
+namespace {
+using TimingClock = std::chrono::steady_clock;
+std::atomic<int64_t> g_last_swap_ns{0};
+std::atomic<uint64_t> g_swap_count{0};
+std::atomic<PPCContext*> g_swap_ctx{nullptr};
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             TimingClock::now().time_since_epoch())
+      .count();
+}
+
+void StallSamplerThread() {
+  uint64_t sampled_for = 0;
+  int samples = 0;
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    if (!rex::diag::TimingLogOn()) continue;
+    const int64_t last = g_last_swap_ns.load(std::memory_order_relaxed);
+    PPCContext* ctx = g_swap_ctx.load(std::memory_order_relaxed);
+    if (!last || !ctx) continue;
+    const uint64_t frame = g_swap_count.load(std::memory_order_relaxed);
+    if (frame != sampled_for) {
+      sampled_for = frame;
+      samples = 0;
+    }
+    const double late_ms = double(NowNs() - last) / 1e6;
+    // Up to three samples per late frame, at about +28, +53 and +78 ms.
+    if (samples < 3 && late_ms >= 28.0 + 25.0 * samples && late_ms < 2000.0) {
+      ++samples;
+      REXLOG_INFO("[timing] late frame +{:.0f} ms: presenting thread at guest lr 0x{:08X}",
+                  late_ms, uint32_t(ctx->lr));
+    }
+  }
+}
+
+void NoteGuestFrame() {
+  if (!rex::diag::TimingLogOn()) {
+    g_last_swap_ns.store(0, std::memory_order_relaxed);
+    return;
+  }
+  static std::atomic<bool> sampler_started{false};
+  if (!sampler_started.exchange(true)) std::thread(StallSamplerThread).detach();
+  if (auto* ts = rex::runtime::ThreadState::Get()) {
+    g_swap_ctx.store(ts->context(), std::memory_order_relaxed);
+  }
+  static std::vector<double> frame_ms;
+  static int64_t window_start = 0;
+  const int64_t now = NowNs();
+  const int64_t prev = g_last_swap_ns.exchange(now, std::memory_order_relaxed);
+  g_swap_count.fetch_add(1, std::memory_order_relaxed);
+  if (!window_start) window_start = now;
+  if (prev) {
+    const double ms = double(now - prev) / 1e6;
+    frame_ms.push_back(ms);
+    if (ms > 25.0 && ms < 2000.0) {
+      REXLOG_INFO("[timing] slow frame: {:.1f} ms", ms);
+    }
+  }
+  if (now - window_start >= 10'000'000'000ll && !frame_ms.empty()) {
+    double sum = 0.0, sq = 0.0, mx = 0.0;
+    for (double v : frame_ms) {
+      sum += v;
+      sq += v * v;
+      mx = std::max(mx, v);
+    }
+    const double mean = sum / double(frame_ms.size());
+    int hitches = 0;  // over 1.5x the average: a stutter you can feel
+    for (double v : frame_ms) hitches += v > mean * 1.5 ? 1 : 0;
+    std::vector<double> sorted = frame_ms;
+    std::sort(sorted.begin(), sorted.end());
+    REXLOG_INFO("[timing] frames: {} frames, {:.2f} fps, frame time mean {:.3f} ms sd {:.3f} "
+                "p99 {:.2f} max {:.2f}, {} hitches (>1.5x mean)",
+                frame_ms.size(), 1000.0 / mean, mean,
+                std::sqrt(std::max(0.0, sq / double(frame_ms.size()) - mean * mean)),
+                sorted[size_t(double(sorted.size() - 1) * 0.99)], mx, hitches);
+    frame_ms.clear();
+    window_start = now;
+  }
+}
