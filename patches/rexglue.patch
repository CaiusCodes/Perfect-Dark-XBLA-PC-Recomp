+void D3D12CommandProcessor::GpuTimeFrameOpen() {
+  const uint32_t slot = uint32_t(frame_current_ % kQueueFrames);
+  // The frame that last used this slot has completed: BeginSubmission awaited
+  // its submission before opening this frame.
+  if (gpu_time_resolved_[slot] && gpu_time_frequency_ && gpu_time_count_[slot] >= 2) {
+    void* mapped = nullptr;
+    const D3D12_RANGE read_range = {slot * kGpuTimeStampsPerFrame * sizeof(uint64_t),
+                                    (slot + 1) * kGpuTimeStampsPerFrame * sizeof(uint64_t)};
+    if (SUCCEEDED(gpu_time_readback_->Map(0, &read_range, &mapped))) {
+      const uint64_t* stamps = static_cast<const uint64_t*>(mapped) + slot * kGpuTimeStampsPerFrame;
+      const double to_ms = 1000.0 / double(gpu_time_frequency_);
+      double frame_ms = 0.0;
+      for (uint32_t i = 0; i + 1 < gpu_time_count_[slot]; i += 2) {
+        if (stamps[i + 1] > stamps[i]) frame_ms += double(stamps[i + 1] - stamps[i]) * to_ms;
+      }
+      const D3D12_RANGE written_range = {};
+      gpu_time_readback_->Unmap(0, &written_range);
+      ++gpu_time_frames_;
+      gpu_time_submissions_ += gpu_time_count_[slot] / 2;
+      gpu_time_sum_ms_ += frame_ms;
+      gpu_time_sq_ms_ += frame_ms * frame_ms;
+      gpu_time_max_ms_ = std::max(gpu_time_max_ms_, frame_ms);
+      gpu_time_over_8_ += frame_ms > 8.0;
+      gpu_time_over_12_ += frame_ms > 12.0;
+      gpu_time_over_16_ += frame_ms > 1000.0 / 60.0;
+      if (gpu_time_frames_ >= 600) {
+        const double n = double(gpu_time_frames_);
+        const double mean = gpu_time_sum_ms_ / n;
+        REXGPU_INFO("[timing] gpu time per frame: {:.2f} ms mean (sd {:.2f}), max {:.2f}, in "
+                    "{:.1f} submissions; frames over 8 ms {}, over 12 ms {}, over 16.7 ms {}",
+                    mean, std::sqrt(std::max(0.0, gpu_time_sq_ms_ / n - mean * mean)),
+                    gpu_time_max_ms_, double(gpu_time_submissions_) / n, gpu_time_over_8_,
+                    gpu_time_over_12_, gpu_time_over_16_);
+        gpu_time_frames_ = gpu_time_submissions_ = 0;
+        gpu_time_sum_ms_ = gpu_time_sq_ms_ = gpu_time_max_ms_ = 0.0;
