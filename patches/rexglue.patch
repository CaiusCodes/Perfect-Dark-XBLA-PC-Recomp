+
+void BeginJoinSearch(uint32_t user_index) {
+  bool expected = false;
+  if (PendingMatchChoice(nullptr)) {
+    REXKRNL_INFO("[netplay] a match choice is already open");
+    return;
+  }
+  if (!searching.compare_exchange_strong(expected, true)) {
+    REXKRNL_INFO("[netplay] already searching for a Private Match");
+    return;
+  }
+  seeking = true;
+  if (RelayConfigured() && !RelayActive()) {
+    PostNotice("Can't reach the online server - looking on your own network...");
+  } else {
+    PostNotice(HasDirectTarget() ? "Connecting..." : "Looking for a match...");
+  }
+  REX_KERNEL_STATE()->BroadcastNotification(kNotificationSystemUi, 1);
+  std::thread([user_index] {
+    const bool found = Search(user_index, false);
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    REX_KERNEL_STATE()->BroadcastNotification(kNotificationSystemUi, 0);
+    if (found) {
+      REX_KERNEL_STATE()->BroadcastNotification(kNotificationInviteAccepted, user_index);
+    }
+    searching = false;
+  }).detach();
+}
+
+bool PendingMatchChoice(std::vector<FoundMatch>* matches) {
+  std::lock_guard<std::mutex> lock(session_mutex);
+  if (choices.empty()) {
+    return false;
+  }
+  if (matches) {
+    matches->clear();
+    for (const Candidate& c : choices) {
+      matches->push_back({c.name.empty() ? std::string("Unnamed") : c.name,
+                          FormatIPv4(c.host_ina)});
+    }
+  }
+  return true;
+}
+
+void ChooseMatch(size_t index) {
+  Candidate match;
+  uint32_t user_index = 0;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (choices.empty()) {
+      return;
+    }
+    const bool accepted = index < choices.size();
+    if (accepted) {
+      match = choices[index];
+      user_index = choice_user_index;
+      AcceptLocked(match, user_index);
+    }
+    choices.clear();
+    if (!accepted) {
+      seeking = false;
+      REXKRNL_INFO("[netplay] match choice cancelled");
+      PostNotice("Join cancelled - friends can join your match instead");
+      return;
+    }
+  }
+  AnnounceJoin(match);
+  REX_KERNEL_STATE()->BroadcastNotification(kNotificationInviteAccepted, user_index);
+}
+
+void OnInviteFriends(uint32_t user_index) {
+  bool host = false;
+  bool guest = false;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    host = hosting && !seeking;
+    guest = joined;
+  }
+  if ((host || guest) && RelayActive()) {
+    const std::string room = RelayRoom();
+    PostNotice(std::string(host ? "Friends join you" : "Friends join this match") +
+               " with Match Type > Join Online Match" +
+               (room == "public" ? std::string() : " (room " + room + ")"));
+    return;
+  }
+  if (host) {
+    std::string addresses;
+    for (const LocalAddress& a : LocalAddresses()) {
+      addresses += (addresses.empty() ? "" : "  ") + a.label + " " + a.address;
+    }
+    REXKRNL_INFO("[netplay] Invite Friends while hosting at {}", addresses);
+    PostNotice("Friends choose Join Match > LAN, or Direct Connect to: " + addresses);
+    return;
+  }
+  if (guest) {
+    PostNotice("Friends join this match with Join Match > LAN or Direct Connect");
+    return;
+  }
+  BeginJoinSearch(user_index);
+}
