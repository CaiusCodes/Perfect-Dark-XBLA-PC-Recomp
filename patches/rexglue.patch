+    const uint32_t xnaddr_ptr = memory::load_and_swap<uint32_t>(GuestBytes(xnaddrs) + i * 4);
+    if (xnaddr_ptr) {
+      results[i] = netplay::QosProbe(REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(xnaddr_ptr));
+    }
+  }
+  uint32_t data_total = 0;
+  for (const auto& result : results) {
+    data_total += uint32_t(result.data.size());
+  }
