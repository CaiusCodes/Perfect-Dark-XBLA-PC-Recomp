+  // PC was 15,693 frames ahead, pulled flat out for a whole match, and held it
+  // 0.33% too slow - the drift reversed rather than removed.
+  auto anchor = [&](const char* why) {
+    if (why) LogSyncSummary(why);
+    g_sync.have_start = true;
+    g_sync.start_at = now;
+    g_sync.host_start = host_count;
+    g_sync.own_start = own;
+    g_sync.have_window = true;
+    g_sync.window_at = now;
+    g_sync.host_window = host_count;
+    g_sync.own_window = own;
+    g_sync.out_windows = 0;
+    g_sync.out_dir = 0;
+    g_sync.last_ahead = 0.0;
+    g_sync.lead_sum = 0.0;
+    g_sync.lead_n = 0;
+    g_sync.calibrated = false;
+    g_sync.lead_zero = 0.0;
+    g_sync.windows = 0;
+    g_sync.max_lead = 0.0;
+    g_sync.changes = 0;
+    if (why && g_sync.active) {
+      REXLOG_INFO("[sync] fresh reference ({}), keeping game speed {:+.3f}%", why,
+                  (g_sync.scale - 1.0) * 100.0);
+    }
+  };
+  const int32_t host_step = g_sync.have_last ? int32_t(host_count - g_sync.last_host) : 0;
+  const double quiet =
+      g_sync.have_last ? std::chrono::duration<double>(now - g_sync.last_seen).count() : 0.0;
+  g_sync.last_seen = now;
+  g_sync.last_host = host_count;
+  const bool first = !g_sync.have_last;
+  g_sync.have_last = true;
+  if (first || !g_sync.have_start) {
+    anchor(nullptr);
+    return len;
+  }
+  if (quiet > 3.0) {
+    anchor("gameplay resumed after a pause");
+    return len;
+  }
+  // Between two packets a few frames at most; far more, or backwards, means the
+  // host's game is not the one the reference was taken from.
+  if (host_step < -2 || host_step > 600) {
+    anchor("the host's frame count jumped");
+    return len;
+  }
+
+  // How far this PC has run ahead of the host since the reference, in frames,
+  // averaged over every packet of the window: the host's count comes every
+  // other frame and a frame late or not, so one reading is only good to a
+  // couple of frames, and three hundred of them average that away.
+  g_sync.lead_sum += double(int64_t(own - g_sync.own_start)) -
+                     double(int32_t(host_count - g_sync.host_start));
+  ++g_sync.lead_n;
+
+  const double span = std::chrono::duration<double>(now - g_sync.window_at).count();
+  if (span < 10.0) return len;
+
+  const double host_frames = double(int32_t(host_count - g_sync.host_window));
+  const double own_frames = double(int64_t(own - g_sync.own_window));
+  const double mean = g_sync.lead_sum / double(g_sync.lead_n);
+  g_sync.window_at = now;
+  g_sync.host_window = host_count;
+  g_sync.own_window = own;
+  g_sync.lead_sum = 0.0;
+  g_sync.lead_n = 0;
+  if (host_frames < span * 30.0 || own_frames < span * 30.0) return len;  // a pause or load
+  // Seconds of lead cannot be real drift - the reference is stale - so start
+  // again rather than act on it.
+  if (std::fabs(mean) > 300.0) {
+    anchor("the lead since the reference made no sense");
+    return len;
+  }
+  // The reference was a single reading; the first full window sets the zero.
+  if (!g_sync.calibrated) {
+    g_sync.calibrated = true;
+    g_sync.lead_zero = mean;
+    return len;
+  }
+  const double ahead = mean - g_sync.lead_zero;
+
+  // Deadband. Two PCs with working clocks stay within a frame or two of each
+  // other for a whole match, and acting on less than that - as the first
+  // version did, every ten seconds, from single readings - swung the joiner's
+  // speed by up to 0.45% for nothing. So a correction starts only when the
+  // lead is beyond two frames for two windows running, and then runs until it
+  // is back within one. It takes the lead back over about a minute. A hitch
+  // leaves a lead that stays put, which that pull alone removes; only a lead
+  // that keeps growing means this PC really runs at a different speed, and
+  // then that difference is learned, in step with how fast it grows, and kept.
+  const bool correcting = g_sync.out_windows >= 2;
+  const double limit = correcting ? 1.0 : 2.0;
+  const int dir = ahead > limit ? 1 : (ahead < -limit ? -1 : 0);
+  g_sync.out_windows = dir == 0 ? 0 : (dir == g_sync.out_dir ? g_sync.out_windows + 1 : 1);
+  g_sync.out_dir = dir;
+  ++g_sync.windows;
+  g_sync.max_lead = std::max(g_sync.max_lead, std::fabs(ahead));
+  const double old_rate = g_sync.rate;
+  double pull = 0.0;
+  if (g_sync.out_windows >= 2) {
+    pull = std::clamp(-ahead / (60.0 * 60.0), -0.001, 0.001);
+    const double growth = std::fabs(ahead) - std::fabs(g_sync.last_ahead);
+    if (growth > 0.5) {
+      g_sync.rate = std::clamp(g_sync.rate - dir * 0.5 * growth / (60.0 * span), -0.004, 0.004);
+    }
+  }
+  g_sync.last_ahead = ahead;
+  const double scale = std::clamp((1.0 + g_sync.rate) * (1.0 + pull), 0.995, 1.005);
+  if (scale != g_sync.scale) {
+    g_sync.scale = scale;
+    g_sync.active = scale != 1.0;
+    ++g_sync.changes;
+    SetGameSpeed(scale);
+  }
+  const bool now_correcting = g_sync.out_windows >= 2;
+  if (now_correcting != correcting || g_sync.rate != old_rate) {
+    REXLOG_INFO("[sync] {:+.1f} frames ahead of the host (host {:.3f} frames/s, this PC {:.3f}) - "
+                "{}, game speed {:+.3f}%",
+                ahead, host_frames / span, own_frames / span,
+                !now_correcting ? "back in step"
+                : correcting    ? "still drifting, speed adjusted"
+                                : "drifting, easing it back",
+                (scale - 1.0) * 100.0);
+  }
+  return len;
+}
+
+// Every packet, exactly as it happened. The two-second summaries average away
+// the thing that matters: whether packets arrive evenly, or in clumps with
+// holes between them.
+static void LogOnePacket(const char* way, uint32_t ina, uint16_t port, const uint8_t* data,
+                         uint32_t len) {
+  if (!REXCVAR_GET(net_log_packets)) return;
+  std::string head;
+  const uint32_t show = len < 8u ? len : 8u;
+  for (uint32_t i = 0; i < show; ++i) head += fmt::format("{:02X}", data[i]);
+  const uint8_t* a = reinterpret_cast<const uint8_t*>(&ina);
+  REXLOG_INFO("[pkt] {} {}.{}.{}.{}:{} {} bytes {}", way, a[0], a[1], a[2], a[3], port,
+              len, head);
+}
+REXCVAR_DEFINE_BOOL(net_loopback_only, true, "Network",
+                    "Bind guest sockets that ask for any address to loopback only, so the "
+                    "game never needs a firewall exception. Turn off for LAN play.");
