+
+// SetHostValue on the host; on a joined PC, the copy its poll last heard.
+std::mutex host_value_mutex;
+uint32_t host_value_seq = 0;
+uint32_t host_value = 0;
+std::chrono::steady_clock::time_point host_value_set_at;
+HostValue heard_value;
