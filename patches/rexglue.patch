+// ---- Internet play through the online relay server (see netplay.h) --------
+// Wire format: perfect-dark-recomp/tools/relay/pd_relay.py.
+constexpr uint32_t kRelayHello = 0x50445248;    // "PDRH"
+constexpr uint32_t kRelayWelcome = 0x50445257;  // "PDRW"
+constexpr uint32_t kRelayData = 0x50445244;     // "PDRD"
+constexpr uint32_t kRelayError = 0x50445245;    // "PDRE"
+constexpr uint8_t kRelayVersion = 1;
+constexpr uint16_t kRelayDefaultPort = 30760;
+constexpr size_t kRelayMaxPayload = 1500;
+
+struct RelayState {
+  std::mutex listeners_mutex;
+  std::map<uint16_t, RelayReceiver> listeners;
+  socket_t socket = kNoSocket;
+  sockaddr_in server = {};
+  std::string server_text;
+  uint8_t token[8] = {};
+  std::atomic<uint32_t> vip{0};  // network byte order; 0 until the server answers
+  std::atomic<bool> active{false};
+  std::atomic<bool> stop{false};
+  std::atomic<uint32_t> next_port{0};
+  std::atomic<uint64_t> bytes_sent{0};
+  std::atomic<uint64_t> bytes_received{0};
+};
+
+RelayState& Relay() {
+  static RelayState state;
+  return state;
+}
+
+std::string Trimmed(std::string text) {
+  text.erase(0, text.find_first_not_of(" \t"));
+  text.erase(text.find_last_not_of(" \t") + 1);
+  return text;
+}
+
+std::atomic<bool> online_mode{false};
+
+bool RelayConfigured() {
+  // Not cached: online play can be switched on while the game is running.
+  // Only ONLINE uses the relay; LAN and Direct Connect never do.
+  return Enabled() && online_mode && !Trimmed(REXCVAR_GET(net_relay_server)).empty();
+}
+
+std::string RelayRoom() {
+  const std::string room = Trimmed(REXCVAR_GET(net_room));
+  return room.empty() ? std::string("public") : room;
+}
+
+// net_relay_server is "host" or "host:port".
+bool ResolveRelayServer(sockaddr_in* out, std::string* text_out) {
+  std::string text = Trimmed(REXCVAR_GET(net_relay_server));
+  if (text.empty()) {
+    return false;
+  }
+  uint16_t port = kRelayDefaultPort;
+  const size_t colon = text.rfind(':');
+  if (colon != std::string::npos) {
+    port = uint16_t(std::strtoul(text.c_str() + colon + 1, nullptr, 10));
+    text.resize(colon);
+  }
+  addrinfo hints = {};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* list = nullptr;
+  if (port == 0 || getaddrinfo(text.c_str(), nullptr, &hints, &list) != 0 || !list) {
+    return false;
+  }
+  *out = *reinterpret_cast<sockaddr_in*>(list->ai_addr);
+  out->sin_port = htons(port);
+  freeaddrinfo(list);
+  *text_out = text + ":" + std::to_string(port);
+  return true;
+}
+
+void RelaySendRaw(const uint8_t* data, size_t size) {
+  RelayState& r = Relay();
+  sendto(r.socket, reinterpret_cast<const char*>(data), int(size), 0,
+         reinterpret_cast<const sockaddr*>(&r.server), sizeof(r.server));
+  r.bytes_sent += size;
+}
+
+void RelaySendHello() {
+  RelayState& r = Relay();
+  uint8_t hello[52] = {};
+  PutBE32(hello, kRelayHello);
+  hello[4] = kRelayVersion;
+  std::memcpy(hello + 8, r.token, sizeof(r.token));
+  const std::string room = RelayRoom();
+  std::memcpy(hello + 16, room.data(), std::min<size_t>(room.size(), 16));
+  const std::string name = PlayerName(std::string());
+  std::memcpy(hello + 32, name.data(), std::min<size_t>(name.size(), 16));
+  // Asks to keep this address if the server restarted.
+  const uint32_t vip = r.vip;
+  std::memcpy(hello + 48, &vip, 4);
+  RelaySendRaw(hello, sizeof(hello));
+}
+
+void RelayHandle(const uint8_t* p, int n) {
+  RelayState& r = Relay();
+  if (n < 4) {
+    return;
+  }
+  const uint32_t magic = GetBE32(p);
+  if (magic == kRelayData && n >= 12) {
+    uint32_t src;
+    std::memcpy(&src, p + 4, 4);
+    const uint16_t src_port = uint16_t((p[8] << 8) | p[9]);
+    const uint16_t dst_port = uint16_t((p[10] << 8) | p[11]);
+    std::lock_guard<std::mutex> lock(r.listeners_mutex);
+    auto it = r.listeners.find(dst_port);
+    if (it != r.listeners.end()) {
+      it->second(src, src_port, p + 12, size_t(n - 12));
+    }
+    return;
+  }
+  if (magic == kRelayWelcome && n >= 26 && std::memcmp(p + 8, r.token, 8) == 0) {
+    uint32_t vip;
+    std::memcpy(&vip, p + 16, 4);
+    uint32_t public_ip;
+    std::memcpy(&public_ip, p + 20, 4);
+    const uint32_t previous = r.vip.exchange(vip);
+    if (previous != vip) {
+      REXKRNL_INFO("[netplay] online server {}: this PC is {} in room \"{}\" (seen from {}:{})",
+                   r.server_text, FormatIPv4(vip), RelayRoom(), FormatIPv4(public_ip),
+                   (p[24] << 8) | p[25]);
+      if (previous != 0) {
+        REXKRNL_WARN("[netplay] the online server changed this PC's address; rejoin the match");
+      }
+    }
+    return;
+  }
+  if (magic == kRelayError && n >= 5) {
+    const std::string text(reinterpret_cast<const char*>(p + 5), size_t(n - 5));
+    REXKRNL_WARN("[netplay] online server refused: {}", text);
+    PostNotice("Online server: " + text);
+  }
+}
+
+// Keeps the registration alive and hands arriving packets to their listener.
+void RelayThread() {
+  RelayState& r = Relay();
+  auto last_hello = std::chrono::steady_clock::now() - std::chrono::seconds(10);
+  auto last_report = std::chrono::steady_clock::now();
+  uint64_t reported_sent = 0;
+  uint64_t reported_received = 0;
+  std::vector<uint8_t> packet(4096);
+  while (!r.stop) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_hello >= std::chrono::milliseconds(r.vip ? 2000 : 500)) {
+      RelaySendHello();
+      last_hello = now;
+    }
+    if (now - last_report >= std::chrono::minutes(1)) {
+      const uint64_t sent = r.bytes_sent;
+      const uint64_t received = r.bytes_received;
+      if (sent - reported_sent > 16384 || received - reported_received > 16384) {
+        REXKRNL_INFO("[netplay] online traffic in the last minute: {} KB sent, {} KB received",
+                     (sent - reported_sent) / 1024, (received - reported_received) / 1024);
+      }
+      reported_sent = sent;
+      reported_received = received;
+      last_report = now;
+    }
+    fd_set readable;
+    FD_ZERO(&readable);
+    FD_SET(r.socket, &readable);
+    timeval timeout = {0, 100 * 1000};
+    if (select(int(r.socket + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+      continue;
+    }
+    sockaddr_in from = {};
+    socklen_t from_len = sizeof(from);
+    const int n = recvfrom(r.socket, reinterpret_cast<char*>(packet.data()), int(packet.size()),
+                           0, reinterpret_cast<sockaddr*>(&from), &from_len);
+    if (n <= 0 || from.sin_addr.s_addr != r.server.sin_addr.s_addr ||
+        from.sin_port != r.server.sin_port) {
+      continue;
+    }
+    r.bytes_received += uint64_t(n);
+    RelayHandle(packet.data(), n);
+  }
+}
+
+// Registers with the online server and waits up to three seconds for this
+// PC's virtual address. False when net_relay_server is empty or the server
+// does not answer; online play then stays on the local network.
+bool RelayStart(uint32_t* vip_out) {
+  RelayState& r = Relay();
+  if (!RelayConfigured()) {
+    return false;
+  }
+  if (r.active) {
+    *vip_out = r.vip;
+    return true;  // already registered; do not start a second thread
+  }
+  if (r.socket != kNoSocket) {
+    // An earlier attempt failed (no server, or no answer). Let its thread go
+    // and start over, rather than leaving two of them on one socket.
+    r.stop = true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(60));
+    closesocket(r.socket);
+    r.socket = kNoSocket;
+    r.stop = false;
+  }
+  if (!ResolveRelayServer(&r.server, &r.server_text)) {
+    REXKRNL_WARN("[netplay] online server \"{}\" not found; online play stays on this network",
+                 REXCVAR_GET(net_relay_server));
+    return false;
+  }
+  r.socket = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (r.socket == kNoSocket) {
+    return false;
+  }
+  if ((ntohl(r.server.sin_addr.s_addr) >> 24) == 127) {
+    // A server on this PC (testing) is reached over loopback, which keeps
+    // Windows Firewall quiet.
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    bind(r.socket, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+  }
+  RandomBytes(r.token, sizeof(r.token));
+  std::thread(RelayThread).detach();
+  for (int i = 0; i < 60 && !r.vip; ++i) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  }
+  if (!r.vip) {
+    r.stop = true;
+    REXKRNL_WARN("[netplay] online server {} did not answer; online play stays on this network",
+                 r.server_text);
+    return false;
+  }
+  r.active = true;
+  *vip_out = r.vip;
+  return true;
+}
+
+// A temporary port on the relay's virtual LAN whose packets queue here.
+class RelayInbox {
+ public:
+  RelayInbox() : port_(RelayEphemeralPort()), queue_(std::make_shared<Queue>()) {
+    auto queue = queue_;
+    RelayListen(port_, [queue](uint32_t src, uint16_t, const uint8_t* data, size_t size) {
+      {
+        std::lock_guard<std::mutex> lock(queue->mutex);
+        if (queue->packets.size() < 64) {
+          queue->packets.emplace_back(src, std::vector<uint8_t>(data, data + size));
+        }
+      }
+      queue->cv.notify_one();
+    });
+  }
+  ~RelayInbox() { RelayUnlisten(port_); }
+  RelayInbox(const RelayInbox&) = delete;
+  RelayInbox& operator=(const RelayInbox&) = delete;
+
+  uint16_t port() const { return port_; }
+
+  // The next packet within timeout_ms: its size, or -1.
+  int Receive(int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+    std::unique_lock<std::mutex> lock(queue_->mutex);
+    queue_->cv.wait_for(lock, std::chrono::milliseconds(timeout_ms),
+                        [this] { return !queue_->packets.empty(); });
+    if (queue_->packets.empty()) {
+      return -1;
+    }
+    auto packet = std::move(queue_->packets.front());
+    queue_->packets.pop_front();
+    *from = packet.first;
+    const size_t size = std::min(cap, packet.second.size());
+    std::memcpy(buf, packet.second.data(), size);
+    return int(size);
+  }
+
+ private:
+  struct Queue {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<std::pair<uint32_t, std::vector<uint8_t>>> packets;
+  };
+  uint16_t port_;
+  std::shared_ptr<Queue> queue_;
+};
+
+struct Identity {
+  uint8_t enet[6];
+  std::vector<uint32_t> addresses;  // network byte order, preferred first
+};
+
+Identity BuildLocalIdentity();
+
+const Identity& Local() {
+  static std::mutex identity_mutex;
+  static std::unique_ptr<Identity> identity;
+  static uint32_t identity_generation = 0;
+  std::lock_guard<std::mutex> lock(identity_mutex);
+  const uint32_t generation = rex::system::NetplayGeneration();
+  if (!identity || identity_generation != generation) {
+    identity = std::make_unique<Identity>(BuildLocalIdentity());
+    identity_generation = generation;
+  }
+  return *identity;
+}
+
+Identity BuildLocalIdentity() {
+  const Identity identity = [] {
+    EnsureWinsock();
+    Identity id;
+    RandomBytes(id.enet, sizeof(id.enet));
+    id.enet[0] = (id.enet[0] & 0xFC) | 0x02;  // locally administered, unicast
+    uint32_t configured = 0;
+    uint32_t relay_vip = 0;
+    if (RelayStart(&relay_vip)) {
+      id.addresses.push_back(relay_vip);
+    } else if (ParseIPv4(REXCVAR_GET(net_address), &configured)) {
+      id.addresses.push_back(configured);
+    } else {
+      char host[256] = {};
+      addrinfo hints = {};
+      hints.ai_family = AF_INET;
+      addrinfo* list = nullptr;
+      if (gethostname(host, sizeof(host) - 1) == 0 &&
+          getaddrinfo(host, nullptr, &hints, &list) == 0) {
+        for (addrinfo* it = list; it; it = it->ai_next) {
+          const uint32_t ina = reinterpret_cast<sockaddr_in*>(it->ai_addr)->sin_addr.s_addr;
+          const uint32_t h = ntohl(ina);
+          if ((h >> 24) == 127 || (h >> 16) == 0xA9FE) {
+            continue;  // loopback, link-local
+          }
+          if (std::find(id.addresses.begin(), id.addresses.end(), ina) != id.addresses.end()) {
+            continue;
+          }
+          // Radmin VPN (26.0.0.0/8) first: it exists only to reach friends.
+          if ((h >> 24) == 26) {
+            id.addresses.insert(id.addresses.begin(), ina);
+          } else {
+            id.addresses.push_back(ina);
+          }
+        }
+        freeaddrinfo(list);
+      }
+      if (id.addresses.empty()) {
+        id.addresses.push_back(htonl(INADDR_LOOPBACK));
+      }
+      if (id.addresses.size() > kMaxAddresses) {
+        id.addresses.resize(kMaxAddresses);
+      }
+    }
+    std::string text;
+    for (uint32_t ina : id.addresses) {
+      text += (text.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+    if (Relay().active) {
+      REXKRNL_INFO("[netplay] Private Match addresses: {} (online server {}, room \"{}\")", text,
+                   Relay().server_text, RelayRoom());
+      return id;
+    }
+    std::string broadcasts;
+    for (uint32_t ina : DirectedBroadcasts()) {
+      broadcasts += (broadcasts.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+    REXKRNL_INFO("[netplay] Private Match addresses: {} (searches also broadcast to: {})", text,
+                 broadcasts.empty() ? std::string("none") : broadcasts);
+    return id;
+  }();
+  return identity;
+}
+
+uint64_t EnetKey(const uint8_t* xnaddr) {
+  uint64_t key = 0;
+  for (int i = 0; i < 6; ++i) {
+    key = (key << 8) | xnaddr[kXnAddrEnet + i];
+  }
+  return key;
+}
+
+void WriteAddressList(uint8_t* online, const std::vector<uint32_t>& addresses) {
+  online[0] = 'P';
+  online[1] = 'D';
+  online[2] = uint8_t(std::min(addresses.size(), kMaxAddresses));
+  for (size_t i = 0; i < online[2]; ++i) {
+    std::memcpy(online + 4 + i * 4, &addresses[i], 4);
+  }
+}
+
+std::vector<uint32_t> Candidates(const uint8_t* xnaddr) {
+  std::vector<uint32_t> result;
+  const uint8_t* online = xnaddr + kXnAddrOnline;
+  if (online[0] == 'P' && online[1] == 'D') {
+    for (size_t i = 0; i < std::min<size_t>(online[2], kMaxAddresses); ++i) {
+      uint32_t ina;
+      std::memcpy(&ina, online + 4 + i * 4, 4);
+      result.push_back(ina);
+    }
+  }
+  if (result.empty()) {
+    uint32_t ina;
+    std::memcpy(&ina, xnaddr + kXnAddrIna, 4);
+    result.push_back(ina);
+  }
+  return result;
+}
