+    return;
+  }
+  // Begun outside a render pass, so it has to end outside one.
+  EndRenderPass();
+  deferred_command_buffer().CmdVkEndQuery(occlusion_query_pool_, host_index);
+  if (!occlusion_pending_.empty()) {
+    occlusion_pending_.back().host_index = host_index;
+    occlusion_pending_.back().has_query = true;
+  }
+}
+
+void VulkanCommandProcessor::ResolveOcclusionSnapshots() {
+  if (occlusion_active_resolve_) return;
+  occlusion_active_resolve_ = true;
+  CloseActiveOcclusionQuery();
+  bool resolved = false;
+  if (!occlusion_pending_.empty() && occlusion_query_pool_ != VK_NULL_HANDLE &&
+      occlusion_query_readback_mapping_) {
+    bool any_query = false;
+    for (const auto& snapshot : occlusion_pending_) any_query |= snapshot.has_query;
+    if (!any_query) {
+      resolved = true;
+    } else if (BeginSubmission(true)) {
+      EndRenderPass();
+      DeferredCommandBuffer& command_buffer = deferred_command_buffer();
+      for (const auto& snapshot : occlusion_pending_) {
+        if (!snapshot.has_query) continue;
+        command_buffer.CmdVkCopyQueryPoolResults(
+            occlusion_query_pool_, snapshot.host_index, 1, occlusion_query_readback_buffer_,
+            sizeof(uint64_t) * snapshot.host_index, sizeof(uint64_t),
+            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+      }
+      // The submission that carries the copies (GetCurrentSubmission counts
+      // fences still in flight, so take the number before waiting).
+      const uint64_t query_submission = GetCurrentSubmission();
+      if (EndSubmission(false)) {
+        // One wait for the whole frame's queries.
+        CheckSubmissionFenceAndDeviceLoss(query_submission);
+        resolved = GetCompletedSubmission() >= query_submission;
+        if (resolved) {
+          const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+          if (!(vulkan_device->memory_types().host_coherent &
+                (uint32_t(1) << occlusion_query_readback_memory_type_))) {
+            VkMappedMemoryRange memory_range = {};
+            memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+            memory_range.memory = occlusion_query_readback_memory_;
+            memory_range.offset = 0;
+            memory_range.size =
+                std::min(rex::round_up(VkDeviceSize(sizeof(uint64_t) * kMaxOcclusionQueries),
+                                       vulkan_device->properties().nonCoherentAtomSize),
+                         occlusion_query_readback_memory_size_);
+            vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1,
+                                                                      &memory_range);
+          }
+        }
+      }
+    }
+  }
+  // Replay in order: each snapshot gets the total that was true when it was
+  // taken. If the resolve failed, snapshots still get the running total so no
+  // closing snapshot is left pending forever.
+  const uint64_t* results = reinterpret_cast<const uint64_t*>(occlusion_query_readback_mapping_);
+  uint64_t raw_sum = 0;
+  uint32_t queries = 0, zero_intervals = 0, small_intervals = 0;
+  for (const auto& snapshot : occlusion_pending_) {
+    WriteGuestOcclusionResult(snapshot.guest_addr, occlusion_running_total_);
+    if (resolved && snapshot.has_query && results) {
+      raw_sum += results[snapshot.host_index];
+      zero_intervals += results[snapshot.host_index] == 0 ? 1 : 0;
+      small_intervals += (results[snapshot.host_index] > 0 &&
+                          NormalizeOcclusionSamples(results[snapshot.host_index]) < 64) ? 1 : 0;
+      ++queries;
+      occlusion_running_total_ += NormalizeOcclusionSamples(results[snapshot.host_index]);
+    }
+  }
+  // vblank_timing_log: once a second, what the frame's occlusion snapshots saw.
+  {
+    static auto window_start = std::chrono::steady_clock::now();
+    static uint64_t frames = 0, snapshots = 0, resolved_frames = 0, query_count = 0, samples = 0,
+                    zeros = 0, smalls = 0;
+    zeros += zero_intervals;
+    smalls += small_intervals;
+    ++frames;
+    snapshots += occlusion_pending_.size();
+    resolved_frames += resolved ? 1 : 0;
+    query_count += queries;
+    samples += raw_sum;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - window_start >= std::chrono::seconds(1)) {
+      if (rex::diag::TimingLogOn() && snapshots) {
+        REXGPU_INFO("[timing] vulkan occlusion: {} resolves ({} completed), {} snapshots, {} "
+                    "queries ({} empty, {} under 64 samples), {} raw samples, running total {}",
+                    frames, resolved_frames, snapshots, query_count, zeros, smalls, samples,
+                    occlusion_running_total_);
+      }
+      window_start = now;
+      frames = snapshots = resolved_frames = query_count = samples = zeros = smalls = 0;
+    }
+  }
+  occlusion_pending_.clear();
+  occlusion_active_resolve_ = false;
+}
