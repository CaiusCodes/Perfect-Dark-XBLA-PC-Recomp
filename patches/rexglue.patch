+// Where an IPv4 bind actually lands, which depends on whether online play is
+// on. Shared by Bind and RebindForNetplay.
+void XSocket::ApplyBindRules(N_XSOCKADDR_IN* name) {
+  namespace netplay = rex::kernel::xam::netplay;
+  if (netplay::Enabled()) {
+    // Private Match: an any-address bind goes to net_address when this copy
+    // has one (two copies on one PC); otherwise it stays as requested.
+    const uint32_t address = netplay::ConfiguredAddress();
+    if (address && name && af_ == AF_INET && uint32_t(name->sin_addr) == 0) {
+      name->sin_addr = ntohl(address);  // host-order value into the BE wrapper
+    }
+    if (name && af_ == AF_INET) {
+      REXLOG_INFO("[net] bind {}:{} (Private Match, type {})",
+                  FormatIPv4(htonl(uint32_t(name->sin_addr))), uint16_t(name->sin_port),
+                  int(type_));
+    }
+  } else if (REXCVAR_GET(net_loopback_only) && name && af_ == AF_INET) {
+    const uint32_t requested = name->sin_addr;
