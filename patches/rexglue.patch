+OnlineStatus Status() {
+  OnlineStatus status;
+  status.enabled = Enabled();
+  status.server = Trimmed(REXCVAR_GET(net_relay_server));
+  status.server_configured = status.enabled && !status.server.empty();
+  status.room = RelayRoom();
+  RelayState& r = Relay();
+  const uint32_t vip = r.vip;
+  status.connected = status.server_configured && r.active && vip != 0;
+  if (vip) {
+    status.address = FormatIPv4(vip);
+  } else {
+    uint32_t configured = 0;
+    if (ParseIPv4(REXCVAR_GET(net_address), &configured)) {
+      status.address = FormatIPv4(configured);
+    }
+  }
+  return status;
+}
