+}
+
+// The answer to a search or QoS query that arrived on the discovery port;
+// empty when there is nothing to say (not hosting, a Join search under way,
+// or not a query).
+std::vector<uint8_t> DiscoveryReply(const uint8_t* packet, size_t size, uint32_t from_ina) {
+  std::vector<uint8_t> reply;
+  if (size < 8 || GetBE32(packet + 4) != kProtocolVersion) {
+    return reply;
+  }
+  if (GetBE32(packet) == kQosQueryMagic) {
+    reply.resize(12);
+    PutBE32(reply.data(), kQosAnswerMagic);
+    PutBE32(reply.data() + 4, kProtocolVersion);
+    std::lock_guard<std::mutex> lock(qos_mutex);
+    PutBE32(reply.data() + 8, uint32_t(qos_data.size()));
+    reply.insert(reply.end(), qos_data.begin(), qos_data.end());
+    return reply;
+  }
+  if (GetBE32(packet) == kValueQueryMagic) {
+    if (!IsHostingSession()) {
+      return reply;
+    }
+    reply.resize(20);
+    PutBE32(reply.data(), kValueAnswerMagic);
+    PutBE32(reply.data() + 4, kProtocolVersion);
+    std::lock_guard<std::mutex> lock(host_value_mutex);
+    PutBE32(reply.data() + 8, host_value_seq);
+    PutBE32(reply.data() + 12, host_value);
+    const auto age = std::chrono::steady_clock::now() - host_value_set_at;
+    PutBE32(reply.data() + 16,
+            host_value_seq == 0
+                ? 0xFFFFFFFFu
+                : uint32_t(std::min<int64_t>(
+                      std::chrono::duration_cast<std::chrono::milliseconds>(age).count(),
+                      0xFFFFFFFEll)));
+    return reply;
+  }
+  if (GetBE32(packet) != kQueryMagic) {
+    return reply;
+  }
+  reply.assign(kAnswerExtSize, 0);
+  uint32_t slots = 0;
+  bool started = false;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (!hosting || seeking) {
+      reply.clear();
+      return reply;
+    }
+    std::memcpy(reply.data() + 8, hosted_info.data(), kSessionInfoSize);
+    slots = session_slots;
+    started = session_started;
+  }
+  PutBE32(reply.data(), kAnswerMagic);
+  PutBE32(reply.data() + 4, kProtocolVersion);
+  const auto& profile = REX_KERNEL_STATE()->user_profile();
+  PutBE64(reply.data() + 8 + kSessionInfoSize, PlayerXuid(profile->xuid()));
+  const std::string name = PlayerName(profile->name());
+  std::memcpy(reply.data() + 16 + kSessionInfoSize, name.data(),
+              std::min<size_t>(name.size(), 15));
+  uint8_t* ext = reply.data() + kAnswerSize;
+  ext[0] = uint8_t(std::min(1 + ActivePeers(), 255));
+  ext[1] = uint8_t(std::min<uint32_t>(slots, 255));
+  ext[2] = started ? kAnswerInProgress : 0;
+  {
+    std::lock_guard<std::mutex> lock(details_mutex);
+    std::memcpy(ext + 4, match_arena.data(), std::min<size_t>(match_arena.size(), 19));
+    std::memcpy(ext + 24, match_mode.data(), std::min<size_t>(match_mode.size(), 19));
+  }
+  REXKRNL_INFO("[netplay] answered a Private Match search from {}", FormatIPv4(from_ina));
+  return reply;
+}
+
+void StartResponder() {
+  bool expected = false;
+  if (!responder_started.compare_exchange_strong(expected, true)) {
+    return;
+  }
+  if (RelayActive()) {
+    RelayListen(kDiscoveryPort,
+                [](uint32_t src, uint16_t src_port, const uint8_t* data, size_t size) {
+                  const std::vector<uint8_t> reply = DiscoveryReply(data, size, src);
+                  if (!reply.empty()) {
+                    RelaySend(kDiscoveryPort, src, src_port, reply.data(), reply.size());
+                  }
+                });
+    REXKRNL_INFO("[netplay] answering Private Match searches on the online server");
+    return;
+  }
+  std::thread([] {
+    EnsureWinsock();
+    socket_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNoSocket) {
+      REXKRNL_WARN("[netplay] could not open the Private Match search socket");
+      responder_started = false;
+      return;
+    }
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_port = htons(kDiscoveryPort);
+    uint32_t configured = 0;
+    local.sin_addr.s_addr =
+        ParseIPv4(REXCVAR_GET(net_address), &configured) ? configured : htonl(INADDR_ANY);
+    if (bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+      REXKRNL_WARN("[netplay] could not listen for Private Match searches on UDP {}",
+                   kDiscoveryPort);
+      CloseSocket(s);
+      responder_started = false;
+      return;
+    }
+    REXKRNL_INFO("[netplay] answering Private Match searches on {}:{}",
+                 FormatIPv4(local.sin_addr.s_addr), kDiscoveryPort);
+    for (;;) {
+      uint8_t packet[64];
+      sockaddr_in from = {};
+      socklen_t from_len = sizeof(from);
+      const int received = recvfrom(s, reinterpret_cast<char*>(packet), sizeof(packet), 0,
+                                    reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (received < 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        continue;
+      }
+      const std::vector<uint8_t> reply =
+          DiscoveryReply(packet, size_t(received), from.sin_addr.s_addr);
+      if (!reply.empty()) {
+        sendto(s, reinterpret_cast<const char*>(reply.data()), int(reply.size()), 0,
+               reinterpret_cast<sockaddr*>(&from), from_len);
+      }
+    }
+  }).detach();
+}
+
+// Takes a heard match as the accepted invite. Needs session_mutex.
+void AcceptLocked(const Candidate& match, uint32_t user_index) {
+  invite.pending = true;
+  invite.user_index = user_index;
+  invite.info = match.info;
+  // The host is reachable at the address it answered from.
+  std::memcpy(invite.info.data() + kInfoHost + kXnAddrIna, &match.host_ina, 4);
+  invite.host_xuid = match.host_xuid;
+}
+
+void AnnounceJoin(const Candidate& match) {
+  REXKRNL_INFO("[netplay] joining {}'s Private Match at {}", match.name,
+               FormatIPv4(match.host_ina));
+  PostNotice("Joining " + (match.name.empty() ? std::string("the host") : match.name) +
+             "'s match");
+}
+
+// net_join_address: one or more host addresses separated by commas.
+std::mutex direct_mutex;
+std::string direct_target;
+
+// "host", "host:port" or an IPv4 address -> network-order IPv4 (0 if none).
+uint32_t ResolveHost(std::string text) {
+  text.erase(0, text.find_first_not_of(" \t"));
+  text.erase(text.find_last_not_of(" \t") + 1);
+  const size_t colon = text.rfind(':');
+  if (colon != std::string::npos) {
+    text.resize(colon);
+  }
+  uint32_t ina = 0;
+  if (text.empty() || ParseIPv4(text, &ina)) {
+    return ina;
+  }
+  EnsureWinsock();
+  addrinfo hints = {};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* list = nullptr;
+  if (getaddrinfo(text.c_str(), nullptr, &hints, &list) == 0 && list) {
+    ina = reinterpret_cast<sockaddr_in*>(list->ai_addr)->sin_addr.s_addr;
+    freeaddrinfo(list);
+  }
+  return ina;
+}
+
+bool HasDirectTarget() {
+  std::lock_guard<std::mutex> lock(direct_mutex);
+  return !direct_target.empty();
+}
+
+std::vector<uint32_t> JoinTargets() {
+  std::vector<uint32_t> targets;
+  {
+    std::lock_guard<std::mutex> lock(direct_mutex);
+    if (!direct_target.empty()) {
+      const uint32_t ina = ResolveHost(direct_target);
+      if (ina) {
+        targets.push_back(ina);
+      } else {
+        REXKRNL_WARN("[netplay] Direct Connect: could not resolve \"{}\"", direct_target);
+      }
+      return targets;
+    }
+  }
+  const std::string list = REXCVAR_GET(net_join_address);
+  size_t start = 0;
+  while (start <= list.size()) {
+    size_t end = list.find(',', start);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string item = list.substr(start, end - start);
+    item.erase(0, item.find_first_not_of(" \t"));
+    item.erase(item.find_last_not_of(" \t") + 1);
+    uint32_t ina = 0;
+    if (ParseIPv4(item, &ina) &&
+        std::find(targets.begin(), targets.end(), ina) == targets.end()) {
+      targets.push_back(ina);
+    }
+    start = end + 1;
+  }
+  return targets;
+}
+
+// Asks for hosted Private Matches - at each net_join_address host, or by a
+// broadcast from every local address - and collects the answers. One match
+// becomes the accepted invite; several wait for the player's choice. Returns
+// true when an invite is ready.
+// With `browse`, the answers only fill the server browser's list.
+bool Search(uint32_t user_index, bool browse) {
+  EnsureWinsock();
+  const Identity& self = Local();
+  std::vector<uint32_t> targets = JoinTargets();
+  if (targets.empty() && HasDirectTarget()) {
+    // Direct Connect to an address that didn't resolve: that is a failed
+    // connect, not a reason to go and join whatever the LAN has.
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (browse) {
+      browse_results.clear();
+    } else {
+      seeking = false;
+      PostNotice("Couldn't find that host address");
+    }
+    return false;
+  }
+  const bool direct = !targets.empty();
+  const bool relay = RelayActive();
+
+  // Packet I/O: through the online server, or native sockets on this PC's
+  // networks. receive() gives a packet's size (-1 for nothing yet) and the
+  // address it came from.
+  std::unique_ptr<RelayInbox> inbox;
+  std::function<void(uint32_t, const uint8_t*, size_t)> send_to;
+  std::function<int(int, uint8_t*, size_t, uint32_t*)> receive;
+  std::vector<socket_t> sockets;
+  if (relay) {
+    inbox = std::make_unique<RelayInbox>();
+    send_to = [&](uint32_t ina, const uint8_t* data, size_t size) {
+      RelaySend(inbox->port(), ina, kDiscoveryPort, data, size);
+    };
+    receive = [&](int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+      return inbox->Receive(timeout_ms, buf, cap, from);
+    };
+  } else {
+    send_to = [&](uint32_t ina, const uint8_t* data, size_t size) {
+      for (socket_t s : sockets) {
+        sockaddr_in target = {};
+        target.sin_family = AF_INET;
+        target.sin_port = htons(kDiscoveryPort);
+        target.sin_addr.s_addr = ina;
+        sendto(s, reinterpret_cast<const char*>(data), int(size), 0,
+               reinterpret_cast<const sockaddr*>(&target), sizeof(target));
+      }
+    };
+    receive = [&](int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+      fd_set readable;
+      FD_ZERO(&readable);
+      socket_t highest = 0;
+      for (socket_t s : sockets) {
+        FD_SET(s, &readable);
+        highest = std::max(highest, s);
+      }
+      timeval timeout = {0, timeout_ms * 1000};
+      if (sockets.empty() ||
+          select(int(highest + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+        return -1;
+      }
+      for (socket_t s : sockets) {
+        if (!FD_ISSET(s, &readable)) {
+          continue;
+        }
+        sockaddr_in f = {};
+        socklen_t f_len = sizeof(f);
+        const int n = recvfrom(s, reinterpret_cast<char*>(buf), int(cap), 0,
+                               reinterpret_cast<sockaddr*>(&f), &f_len);
+        if (n >= 0) {
+          *from = f.sin_addr.s_addr;
+          return n;
+        }
+      }
+      return -1;
+    };
+  }
+  auto open = [&](uint32_t bind_ina) {
+    socket_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNoSocket) {
+      return;
+    }
+    int yes = 1;
+    setsockopt(s, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&yes), sizeof(yes));
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = bind_ina;
+    if (bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+      CloseSocket(s);
+      return;
+    }
+    sockets.push_back(s);
+  };
+  uint32_t configured = 0;
+  if (relay) {
+    // Nothing to open: the inbox is this search's port on the virtual LAN.
+  } else if (direct) {
+    open(ParseIPv4(REXCVAR_GET(net_address), &configured) ? configured : htonl(INADDR_ANY));
+  } else {
+    // A broadcast leaves through the adapter its socket is bound to.
+    for (uint32_t ina : self.addresses) {
+      open(ina);
+    }
+  }
+  std::string where;
+  if (direct) {
+    for (uint32_t ina : targets) {
+      where += (where.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+  } else if (relay) {
+    targets.push_back(htonl(INADDR_BROADCAST));
+    where = "the online server (room \"" + RelayRoom() + "\")";
+  } else {
+    targets.push_back(htonl(INADDR_BROADCAST));
+    for (uint32_t ina : DirectedBroadcasts()) {
+      targets.push_back(ina);
+    }
+    where = "the local network (";
+    for (size_t i = 0; i < targets.size(); ++i) {
+      where += (i ? ", " : "") + FormatIPv4(targets[i]);
+    }
+    where += ")";
+  }
+  REXKRNL_INFO("[netplay] searching {} for a Private Match", where);
+
+  uint8_t query[8];
+  PutBE32(query, kQueryMagic);
+  PutBE32(query + 4, kProtocolVersion);
+  std::vector<Candidate> found;
+  // Asking hosts directly ends once each has answered.
+  auto everyone_answered = [&] { return direct && found.size() >= targets.size(); };
+  const bool can_send = relay || !sockets.empty();
+  for (int round = 0; round < 4 && !everyone_answered() && can_send; ++round) {
+    // A broadcast listens one more round after the first answer, for other
+    // hosts, then stops.
+    if (!direct && !browse && round >= 2 && !found.empty()) {
+      break;
+    }
+    for (uint32_t ina : targets) {
+      send_to(ina, query, sizeof(query));
+    }
+    const auto sent_at = std::chrono::steady_clock::now();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(400);
+    while (!everyone_answered() && std::chrono::steady_clock::now() < deadline) {
+      uint8_t answer[kAnswerExtSize + 16];
+      uint32_t from_ina = 0;
+      const int received = receive(100, answer, sizeof(answer), &from_ina);
+      if (received < int(kAnswerSize) || GetBE32(answer) != kAnswerMagic ||
+          GetBE32(answer + 4) != kProtocolVersion) {
+        continue;
+      }
+      const uint8_t* info = answer + 8;
+      if (std::memcmp(info + kInfoHost + kXnAddrEnet, self.enet, sizeof(self.enet)) == 0) {
+        continue;  // our own match
+      }
+      const uint64_t key = EnetKey(info + kInfoHost);
+      if (std::any_of(found.begin(), found.end(), [&](const Candidate& c) {
+            return EnetKey(c.info.data() + kInfoHost) == key;
+          })) {
+        continue;  // the same host answering again
+      }
+      Candidate match;
+      std::memcpy(match.info.data(), info, kSessionInfoSize);
+      match.host_xuid = GetBE64(answer + 8 + kSessionInfoSize);
+      match.host_ina = from_ina;
+      char name[17] = {};
+      std::memcpy(name, answer + 16 + kSessionInfoSize, 16);
+      match.name = name;
+      match.ping_ms = std::max(1, int(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                          std::chrono::steady_clock::now() - sent_at)
+                                          .count()));
+      if (received >= int(kAnswerExtSize)) {
+        const uint8_t* ext = answer + kAnswerSize;
+        match.players = ext[0];
+        match.max_players = ext[1];
+        match.in_progress = (ext[2] & kAnswerInProgress) != 0;
+        char arena[21] = {};
+        char mode[21] = {};
+        std::memcpy(arena, ext + 4, 20);
+        std::memcpy(mode, ext + 24, 20);
+        match.arena = arena;
+        match.mode = mode;
+      }
+      {
+        std::lock_guard<std::mutex> lock(peers_mutex);
+        reachable[key] = match.host_ina;
+      }
+      REXKRNL_INFO("[netplay] found {}'s Private Match at {}", match.name,
+                   FormatIPv4(match.host_ina));
+      found.push_back(std::move(match));
+    }
+  }
+  inbox.reset();
+  for (socket_t s : sockets) {
+    CloseSocket(s);
+  }
+  std::lock_guard<std::mutex> lock(session_mutex);
+  if (browse) {
+    REXKRNL_INFO("[netplay] server browser: {} match(es) on {}", found.size(), where);
+    browse_results = std::move(found);
+    return !browse_results.empty();
+  }
+  if (found.empty()) {
+    seeking = false;
+    REXKRNL_INFO("[netplay] no Private Match answered on {}", where);
+    std::string text = direct  ? "No game answered at " + where
+                       : relay ? std::string("No online match found")
+                               : std::string("No game found on your network");
+    if (hosting) {
+      text += " - friends can join your match instead";
+    }
+    PostNotice(text);
+    return false;
+  }
+  if (found.size() == 1) {
+    AcceptLocked(found[0], user_index);
+    AnnounceJoin(found[0]);
+    return true;
+  }
+  choices = std::move(found);
+  choice_user_index = user_index;
+  REXKRNL_INFO("[netplay] {} Private Matches answered; waiting for the player's choice",
+               choices.size());
+  PostNotice("Found " + std::to_string(choices.size()) + " online matches - choose one");
+  return false;
+}
