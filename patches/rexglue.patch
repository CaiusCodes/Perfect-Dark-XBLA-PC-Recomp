+void SharedMemory::CountUploads(const std::vector<std::pair<uint32_t, uint32_t>>& page_ranges) {
+  const uint32_t page_size = uint32_t(1) << page_size_log2_;
+  if (upload_stats_hash_.empty()) {
+    upload_stats_hash_.assign(size_t(kBufferSize >> page_size_log2_), 0);
+  }
+  for (const auto& range : page_ranges) {
+    upload_stats_ranges_++;
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      const uint32_t address = page << page_size_log2_;
+      if (address >= kBufferSize) break;
+      const uint8_t* data = memory_.TranslatePhysical(address);
